{
    "name": "zvizvi/filament-column-tools",
    "description": "Excel-style column header filters for Filament tables, with search, date range and multi-select filter types that sync with regular table filters.",
    "keywords": [
        "zvizvi",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-column-tools",
        "table",
        "filters"
    ],
    "homepage": "https://github.com/zvizvi/filament-column-tools",
    "support": {
        "issues": "https://github.com/zvizvi/filament-column-tools/issues",
        "source": "https://github.com/zvizvi/filament-column-tools"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "zvizvi",
            "email": "yaakov@workflow.co.il",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "filament/forms": "^5.0",
        "filament/tables": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Zvizvi\\FilamentColumnTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zvizvi\\FilamentColumnTools\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zvizvi\\FilamentColumnTools\\FilamentColumnToolsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
