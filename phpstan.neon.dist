includes:
    - phpstan-baseline.neon

parameters:
    level: 4
    paths:
        - src
    tmpDir: build/phpstan
    ignoreErrors:
        # Macro closures are rebound to the column instance at runtime.
        -
            identifier: variable.undefined
            path: src/FilamentColumnFilters.php
        -
            identifier: varTag.variableNotFound
            path: src/FilamentColumnFilters.php
        # An opt-in trait for consumers to apply to their own pages; nothing
        # inside the package uses it.
        -
            identifier: trait.unused
            path: src/Concerns/HasColumnFilters.php
